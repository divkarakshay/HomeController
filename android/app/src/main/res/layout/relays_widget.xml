        <TextView android:id="@+id/w_name_5" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_5" style="@style/WidgetState" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_6"
        style="@style/WidgetRow">
        <TextView android:id="@+id/w_name_6" style="@style/WidgetName" />
