<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/w_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_dot"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/w_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="HomeController"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row_0"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_0" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_0" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_0" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_0" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_1"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_1" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_1" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_1" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_1" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_2"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_2" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_2" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_2" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_2" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_3"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_3" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_3" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_3" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_3" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_4"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_4" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_4" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_4" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_4" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_5"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_5" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_5" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_5" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_5" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_6"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_6" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_6" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_6" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_6" style="@style/WidgetTimer" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_7"
        style="@style/WidgetRow">
        <ImageView android:id="@+id/w_icon_7" style="@style/WidgetIcon" />
        <TextView android:id="@+id/w_name_7" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_7" style="@style/WidgetState" />
        <ImageView android:id="@+id/w_timer_7" style="@style/WidgetTimer" />
    </LinearLayout>
</LinearLayout>