<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HomeController"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/w_row_0"
        style="@style/WidgetRow">
        <TextView android:id="@+id/w_name_0" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_0" style="@style/WidgetState" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_1"
        style="@style/WidgetRow">
        <TextView android:id="@+id/w_name_1" style="@style/WidgetName" />
        <TextView android:id="@+id/w_state_1" style="@style/WidgetState" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_2"
